    <!-- Limitations and privacy (T076) -->
    <string name="limitations_title">Limitations</string>
    <string name="limit_no_control">Kids Garden does not control the whole phone and does not block apps. It slows the internet.</string>
    <string name="limit_best_effort">Slowing is best effort. Downloaded or saved content, and apps that work offline, are not slowed.</string>
    <string name="limit_other_vpn">If another VPN app is turned on, Kids Garden cannot slow the internet until that VPN is turned off.</string>
    <string name="limit_forgot_pin">Forgot the PIN? Clear Kids Garden’s storage in Android settings, or reinstall it, and then set it up again.</string>
    <string name="limit_future">Stronger protection that is harder to remove is planned for a future version.</string>
    <string name="privacy_screen_title">Privacy</string>
