<?xml version="1.0" encoding="utf-8"?>
<!--
    All user-visible text for Kids Garden V1 (English only, NFR-008).
    Exact wording required by the spec is marked; tests assert against these
    resource IDs rather than duplicated literals.
-->
<resources>
    <string name="app_name">Kids Garden</string>

    <!-- PIN (FR-006, exact) -->
    <string name="pin_mismatch">That PIN did not match. Try again.</string>

    <!-- Capability and errors (contracts/parent-ui.md, exact) -->
    <string name="vpn_limited">Dull Mode is limited until VPN setup is complete.</string>
    <string name="call_limitation">Play time pauses during normal phone calls. Calls in other apps, such as WhatsApp, are not slowed down but do not pause play time.</string>
    <string name="settings_save_failed">Settings could not be saved. Please try again.</string>
    <string name="limits_uninstall">Kids Garden can be uninstalled or stopped through Android settings.</string>
    <string name="privacy_summary">Settings stay on this phone. Kids Garden does not collect content, activity history, or logs.</string>

    <!-- Foreground notification (FR-029, exact; no mode or session details) -->
    <string name="notification_running">Kids Garden is running</string>
    <string name="notification_channel_name">Kids Garden status</string>

    <!-- Parent Mode (FR-008) -->
    <string name="parent_mode_confirmation">Parent Mode is on. Locking the phone or turning off the screen ends it.</string>

    <!-- Common -->
    <string name="action_continue">Continue</string>
    <string name="action_try_again">Try again</string>
    <string name="action_finish">Finish</string>

    <!-- Setup: welcome and privacy (T034) -->
    <string name="welcome_title">Welcome to Kids Garden</string>
    <string name="welcome_body">Kids Garden keeps this phone calm by default. Games, videos, and browsing stay slow until you start play time.</string>
    <string name="welcome_start">Get started</string>
    <string name="privacy_title">Privacy and limits</string>
    <string name="privacy_local_vpn">Kids Garden slows the internet with a VPN that runs only on this phone. Traffic is not sent to any Kids Garden server.</string>
    <string name="privacy_no_account">There is no account, and setup never resets the phone.</string>

    <!-- Setup: create PIN (T035) -->
    <string name="create_pin_title">Create a parent PIN</string>
    <string name="create_pin_body">Choose one to six digits. You will need this PIN to give the phone to your child or change settings.</string>
    <string name="pin_label">PIN</string>
    <string name="pin_confirm_label">Confirm PIN</string>
    <string name="pin_save">Save PIN</string>
    <string name="pin_invalid_format">Use one to six digits.</string>
    <string name="pin_confirmation_mismatch">The two PINs do not match.</string>
    <string name="pin_already_created">A parent PIN already exists.</string>

    <!-- Setup: notifications (T037) -->
    <string name="notifications_title">Notifications</string>
    <string name="notifications_body">While Kids Garden is running, Android shows a small notification. It only says “Kids Garden is running.”</string>
    <string name="notifications_allow">Allow notifications</string>
    <string name="notifications_denied">Notifications are off. Kids Garden still works.</string>
    <string name="notifications_allowed">Notifications are on.</string>

    <!-- Setup: VPN (T036) -->
    <string name="vpn_title">Slow down the internet</string>
    <string name="vpn_body">Kids Garden uses Android’s VPN feature to slow the internet on this phone. Traffic stays on the phone and goes straight to your network. Phone calls, text messages, and WhatsApp are not slowed.</string>
    <string name="vpn_prompt_notice">Android will ask you to allow the VPN connection.</string>
    <string name="vpn_set_up">Set up VPN</string>
    <string name="vpn_status_running">Dull Mode is active.</string>
    <string name="vpn_status_starting">Starting the VPN…</string>
    <string name="vpn_status_denied">VPN permission was not given. You can try again at any time.</string>
    <string name="vpn_status_failed">The VPN could not start. Another VPN app may be active.</string>

    <!-- Setup: phone calls (T062) -->
    <string name="phone_title">Phone calls</string>
    <string name="phone_body">Kids Garden can pause play time during normal phone calls. Android will ask to let Kids Garden see whether a phone call is in progress. Kids Garden never sees who is calling or any call details.</string>
    <string name="phone_allow">Allow call detection</string>
    <string name="phone_skip">Skip</string>
    <string name="phone_allowed">Play time pauses during normal phone calls.</string>

    <!-- Give phone to child (T063) -->
    <string name="child_duration_title">How long can your child play?</string>
    <plurals name="child_duration_minutes">
        <item quantity="one">%1$d minute</item>
        <item quantity="other">%1$d minutes</item>
    </plurals>
    <plurals name="child_duration_increase">
        <item quantity="one">Add %1$d minute</item>
        <item quantity="other">Add %1$d minutes</item>
