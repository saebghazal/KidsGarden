    <!-- Effect access explanations (FR-036, T116) -->
    <string name="overlay_title">Grey screen</string>
    <string name="overlay_body">The grey screen slowly washes out colours while the phone is in Dull Mode. It never blocks touches and never shows a message. Android will open “Display over other apps”; turn it on for Kids Garden, then come back.</string>
    <string name="overlay_open">Open Display over other apps</string>
    <string name="settings_write_title">Lower brightness</string>
    <string name="settings_write_body">Lower brightness slowly dims the screen while the phone is in Dull Mode and puts your brightness back when it stops. Android will open “Modify system settings”; turn it on for Kids Garden, then come back.</string>
    <string name="settings_write_open">Open Modify system settings</string>
    <string name="access_granted">Access is on.</string>

